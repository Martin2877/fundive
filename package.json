{
  "name": "fundive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在线洞潜游戏 — 3D 洞穴潜水 · 单人/多人 · 拍照图鉴 · 平行宇宙",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin2877/fundive.git"
  },
  "homepage": "https://github.com/Martin2877/fundive#readme",
  "keywords": [
    "cave-diving",
    "game",
    "threejs",
    "webgl",
    "multiplayer",
    "procedural-generation"
  ],
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "node server/src/index.js",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "i18n": "node scripts/i18ncheck.mjs --list",
    "test": "node scripts/worldtest.mjs && node scripts/oceantest.mjs && node scripts/icetest.mjs && node scripts/smoke.mjs && node scripts/i18ncheck.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
